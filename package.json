{
  "name": "neuroloom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "brand"
  ],
  "scripts": {
    "dev": "npm run dev -w @neuroloom/studio",
    "desktop": "npm run dev -w @neuroloom/desktop",
    "build": "npm run build -w @neuroloom/studio",
    "build:desktop": "npm run build -w @neuroloom/desktop",
    "dist": "npm run dist -w @neuroloom/desktop --",
    "test": "npm run test --workspaces --if-present",
    "test:py": "node scripts/py.mjs -m pytest -q",
    "smoke": "npm run smoke -w @neuroloom/desktop",
    "perf": "npm run perf -w @neuroloom/desktop",
    "startup": "npm run startup -w @neuroloom/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "brand": "npm run build -w @neuroloom/brand",
    "specs": "npm run specs -w @neuroloom/core"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
